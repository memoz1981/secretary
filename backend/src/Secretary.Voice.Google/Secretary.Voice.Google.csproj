<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Secretary.Voice.Google</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Secretary.Voice/Secretary.Voice.csproj" />
    <ProjectReference Include="../Secretary.Domain/Secretary.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The official Google Gen AI SDK. Covers both the Gemini Developer API (AI Studio keys)
         and the Enterprise Agent Platform, and carries the Live websocket client. -->
    <PackageReference Include="Google.GenAI" Version="1.16.0" />
    <!-- Microsoft.Extensions.AI.Abstractions is deliberately not pinned: Google.GenAI requires
         10.6.0 and an explicit 9.x floor here reads to NuGet as a downgrade. It arrives
         transitively, and Secretary.Voice's own 9.x floor unifies upward to the same version. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
  </ItemGroup>
</Project>
