<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Secretary.Api</RootNamespace>
    <!-- Deliberately the same id as the old solution's Api, so the OpenAI key already in
         user-secrets keeps working without being re-entered. -->
    <UserSecretsId>ai-appointment-api-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Secretary.Application/Secretary.Application.csproj" />
    <ProjectReference Include="../Secretary.Infrastructure/Secretary.Infrastructure.csproj" />
    <ProjectReference Include="../Secretary.Domain/Secretary.Domain.csproj" />
    <ProjectReference Include="../Secretary.Agents/Secretary.Agents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*" PrivateAssets="all" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.*" />
  </ItemGroup>
</Project>
