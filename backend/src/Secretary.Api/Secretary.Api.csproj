<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Secretary.Api</RootNamespace>
    <!-- Its own store, not the old solution's. Sharing one looked convenient (the OpenAI key
         would carry over) but the same store also holds ConnectionStrings:Default, which
         outranks appsettings.Development.json — so Secretary would have kept connecting to SQL
         Server, and repointing it would have broken the Appointment solution. -->
    <UserSecretsId>secretary-api-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Secretary.Application/Secretary.Application.csproj" />
    <ProjectReference Include="../Secretary.Infrastructure/Secretary.Infrastructure.csproj" />
    <ProjectReference Include="../Secretary.Domain/Secretary.Domain.csproj" />
    <ProjectReference Include="../Secretary.Agents/Secretary.Agents.csproj" />
    <!-- The composition root is the only project that references providers. -->
    <ProjectReference Include="../Secretary.Voice/Secretary.Voice.csproj" />
    <ProjectReference Include="../Secretary.Voice.OpenAi/Secretary.Voice.OpenAi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*" PrivateAssets="all" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <!-- Swap for Hangfire.PostgreSql at the production deploy, alongside the EF provider. -->
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.*" />
  </ItemGroup>
</Project>
