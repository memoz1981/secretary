<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the API.

  ⚠ The only reason this file exists by hand: WebDAV. IIS ships WebDAV enabled, and it claims the
  PUT and DELETE verbs before ASP.NET Core ever sees the request — the module answers 405 Method
  Not Allowed itself. Measured against the deployed API:

      GET    /api/tenants/1  ->  401   (reached the app; auth refused it, correctly)
      PUT    /api/tenants/1  ->  405   (never reached the app)
      DELETE /api/tenants/1  ->  405   (never reached the app)

  Every "cannot edit" and "cannot delete" report came from this one cause: granting a module,
  editing a service, a provider, a client, a product, business hours. Adding worked everywhere
  because POST is not a verb WebDAV wants.

  The publish step merges the SDK's own aspNetCore handler into this file rather than replacing
  it, so both halves end up in the published web.config.

  If IIS answers 500 after this, the host has locked the modules section at server level — then
  WebDAV has to be turned off for the site in the hosting panel instead.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
