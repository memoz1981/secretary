<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the API.

  ⚠ The only reason this file exists by hand: WebDAV. IIS ships WebDAV enabled, and it claims the
  PUT and DELETE verbs before ASP.NET Core ever sees the request — the module answers 405 Method
  Not Allowed itself. Measured against the deployed API:

      GET    /api/tenants/1  ->  401   (reached the app; auth refused it, correctly)
      PUT    /api/tenants/1  ->  405   (never reached the app)
      DELETE /api/tenants/1  ->  405   (never reached the app)

  Every "cannot edit" and "cannot delete" report came from this one cause: granting a module,
  editing a service, a provider, a client, a product, business hours. Adding worked everywhere
  because POST is not a verb WebDAV wants.

  The publish step merges the SDK's own aspNetCore handler into this file rather than replacing
  it, so both halves end up in the published web.config.

  If IIS answers 500 after this, the host has locked the modules section at server level — then
  WebDAV has to be turned off for the site in the hosting panel instead.

  ⚠ TEMPORARY — the logging below is on to diagnose calls failing on sekretar.az, and must come
  back off. stdoutLogEnabled writes every console line to disk and never rotates the file, so on
  a chatty log level it fills the quota; Microsoft's own guidance is troubleshooting only. Set
  both back to false once the cause is known.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>

      <!--
        Two different logs, and they answer different questions.

        stdout  — the application's own output, once it is running. Everything the orchestrator
                  writes about a call lands here: the tool calls, the turn timings, the token
                  usage, and any exception thrown mid-call.

        ancm    — the module in front of it. This is the one that answers "the app never
                  started", which stdout cannot, because a process that dies on startup writes
                  nothing to it. If the API returns 500.30 or 502.5, read this first.

        The logs folder is created by the module, but some hosts deny it — if neither file
        appears, make ".\logs" by hand and give the app pool write access.
      -->
      <aspNetCore
        processPath="dotnet"
        arguments=".\Secretary.Api.dll"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\stdout"
        hostingModel="inprocess">
        <handlerSettings>
          <handlerSetting name="debugLevel" value="FILE,TRACE" />
          <handlerSetting name="debugFile" value=".\logs\ancm.log" />
        </handlerSettings>
        <environmentVariables>
          <!-- Turns a bare 500 into the actual exception and stack. Temporary: it shows internals
               to anyone who can reach the URL. -->
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="true" />
          <!-- The call path specifically. appsettings.Production.json holds these at Information,
               which is too quiet to see why a call fails; double underscore is the nesting
               separator. -->
          <environmentVariable name="Logging__LogLevel__Secretary.Agents" value="Debug" />
          <environmentVariable name="Logging__LogLevel__Secretary.Api.Voice" value="Debug" />
          <environmentVariable name="Logging__LogLevel__Secretary.Voice.Google" value="Debug" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
