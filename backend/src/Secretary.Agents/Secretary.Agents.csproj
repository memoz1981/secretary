<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Secretary.Agents</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Secretary.Application/Secretary.Application.csproj" />
    <ProjectReference Include="../Secretary.Domain/Secretary.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.*" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
    <PackageReference Include="NodaTime" Version="3.*" />
    <!-- Explicit (not left to whatever Microsoft.Agents.AI.OpenAI pulls transitively) so
         OpenAI.Realtime's RealtimeClient — the official SDK's GA-schema-aware Realtime API
         client — is guaranteed available. See Common/Realtime/RealtimeVoiceSession.cs. -->
    <PackageReference Include="OpenAI" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Modules\Appointment\Instructions\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
