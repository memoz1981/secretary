<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Secretary.Agents</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Secretary.Application/Secretary.Application.csproj" />
    <ProjectReference Include="../Secretary.Domain/Secretary.Domain.csproj" />
    <!-- The neutral realtime abstraction only. No provider project is referenced here — the
         composition root wires those, which is what keeps this layer free of vendor SDKs. -->
    <ProjectReference Include="../Secretary.Voice/Secretary.Voice.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Agents.AI.OpenAI stays: AgentFactory's text-agent path still builds a
         ChatClientAgent over OpenAI. The realtime WebSocket client moved out with the session,
         so the direct OpenAI package reference is gone. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.*" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
    <PackageReference Include="NodaTime" Version="3.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Link, not a bare Include: CopyToOutputDirectory otherwise mirrors the source path, so
         the file would land in bin/.../Modules/Appointment/Instructions/ while
         InstructionLoader reads bin/.../Instructions/. Flat in the output for now; a second
         module bringing its own PhoneAgent.md would collide and the loader would need a
         module-qualified path. -->
    <None Include="Modules\**\Instructions\*.md"
          Link="Instructions\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
