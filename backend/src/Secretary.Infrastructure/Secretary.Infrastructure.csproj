<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Secretary.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Secretary.Application/Secretary.Application.csproj" />
    <ProjectReference Include="../Secretary.Domain/Secretary.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQL Server for now, PostgreSQL at production deploy. Both packages stay referenced so
         the parked Postgres migration can be regenerated without a package dance; only the
         provider chosen in DependencyInjection decides which one runs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated against Npgsql and kept for the production move. Excluded from the build so
         it cannot be applied to SQL Server by accident: its SQL is PostgreSQL-specific. -->
    <Compile Remove="Common\Persistence\Migrations.Postgres\**" />
    <None Include="Common\Persistence\Migrations.Postgres\**" />
  </ItemGroup>
</Project>
