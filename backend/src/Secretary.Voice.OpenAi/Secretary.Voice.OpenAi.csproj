<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Secretary.Voice.OpenAi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Secretary.Voice/Secretary.Voice.csproj" />
    <ProjectReference Include="../Secretary.Domain/Secretary.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
    <!-- Logging.Abstractions is deliberately not pinned here: the OpenAI SDK drags in a much
         newer System.ClientModel that requires 10.x, and an explicit 8.x floor reads to NuGet
         as a downgrade and fails the build. Let it come in transitively. -->
  </ItemGroup>
</Project>
